{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx -y pnpm@10 install --frozen-lockfile --filter @workspace/shlok-terminal-portfolio...",
  "buildCommand": "PORT=3000 BASE_PATH=/ npx -y pnpm@10 --filter @workspace/shlok-terminal-portfolio run build",
  "outputDirectory": "artifacts/shlok-terminal-portfolio/dist/public",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
